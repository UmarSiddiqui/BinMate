# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase connection pooler (newer projects use pooler, not direct db. hostname)
# Note: URL-encode special characters in password (@ → %40)
# Username format for pooler: postgres.{project-ref}
# Transaction pooler (port 6543) — used by app at runtime
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler (port 5432) — used by prisma migrate
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Admin Dashboard ──────────────────────────────────────────────────────────
ADMIN_PASSWORD=

# ─── External Cron (Render free tier) ───────────────────────────────────────────
# Used to validate POST /api/v1/cron/trigger-notifications from cron-job.org
# Generate: openssl rand -hex 32
CRON_SECRET=

# ─── Push Notifications ───────────────────────────────────────────────────────
# TODO: Add when Apple Developer account is set up (Phase 2.2)
# Option A — Direct APNs (recommended, no third-party):
#   APNS_KEY_ID=
#   APNS_TEAM_ID=
#   APNS_BUNDLE_ID=app.binmate.ios
#   APNS_KEY_PATH=./certs/AuthKey_XXXXXX.p8
# Option B — Firebase Admin SDK (if you prefer FCM):
#   FCM_SERVICE_ACCOUNT_KEY=

# ─── Geocoding ────────────────────────────────────────────────────────────────
# Nominatim (OpenStreetMap) — free, no key needed. Rate limit: 1 req/sec.
# No key required. Contact email used in User-Agent header:
GEOCODING_CONTACT_EMAIL=contact@binmate.app

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── RevenueCat (webhook validation) ─────────────────────────────────────────
REVENUECAT_WEBHOOK_AUTH_HEADER=
