{
  "name": "binmate-backend",
  "version": "1.0.0",
  "description": "BinMate API — Perth bin collection schedule service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --watch .env src/index.ts",
    "build": "tsc --ignoreDeprecations 5.0",
    "start": "node dist/index.js",
    "start:render": "npm run db:deploy && npm run start",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-all": "tsx prisma/seed-all.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node-cron": "^3.0.11",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.1",
    "node-cron": "^3.0.3",
    "winston": "^3.14.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
